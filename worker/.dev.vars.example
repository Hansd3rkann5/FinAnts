# Kopiere diese Datei als .dev.vars und trage deine Werte ein.
# .dev.vars wird von .gitignore ausgeschlossen und nie commitet.

# BLZ deiner Commerzbank-Filiale (8 Stellen), z.B. 20041100 für Hamburg
FINTS_BLZ=20041100
# Deine Commerzbank Teilnehmernummer
FINTS_USERNAME=deine_teilnehmernummer
FINTS_PIN=dein_pin
API_KEY=test-key-lokal-32zeichen-xxxx
ALLOWED_ORIGIN=http://localhost:5173
